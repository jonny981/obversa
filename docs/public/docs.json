{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Obversa",
  "description": "Public documentation for the Obversa packages",
  "colors": {
    "primary": "#1C7C54",
    "light": "#73E2A7",
    "dark": "#1C7C54"
  },
  "fonts": {
    "heading": {
      "family": "Schibsted Grotesk"
    },
    "body": {
      "family": "Schibsted Grotesk"
    }
  },
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg",
    "href": "https://obversa.ai"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": [
          "index",
          "get-started/installation",
          "get-started/first-run"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/index",
          "concepts/orders",
          "concepts/workflows",
          "concepts/surfaces",
          "concepts/runtime"
        ]
      },
      {
        "group": "Workflows",
        "pages": [
          "workflows/index",
          "workflows/offline-review",
          "workflows/safe-change",
          "workflows/feature-delivery",
          "workflows/forge-helper"
        ]
      },
      {
        "group": "Reviewing",
        "pages": [
          "reviewing/callback-gates",
          "reviewing/review-loop",
          "reviewing/proof-acceptance"
        ]
      },
      {
        "group": "Recording runs",
        "pages": [
          "recording/how-a-run-is-recorded",
          "recording/events-and-artifacts",
          "recording/node-attempts"
        ]
      },
      {
        "group": "Driving runs",
        "pages": [
          "driving/runner",
          "hosts/cmux",
          "hosts/review"
        ]
      },
      {
        "group": "Writing workflow shapes",
        "pages": [
          "graphs/contract",
          "graphs/pipeline",
          "graphs/plan-admission",
          "graphs/executor"
        ]
      },
      {
        "group": "Memory",
        "pages": [
          "memory/index",
          "memory/adapters",
          "memory/mechanics"
        ]
      },
      {
        "group": "Workspace",
        "pages": [
          "workspace/contract",
          "workspace/example"
        ]
      },
      {
        "group": "Core packages",
        "pages": [
          "packages/runtime",
          "packages/runner",
          "packages/engine",
          "packages/memory",
          "packages/surfacer"
        ]
      },
      {
        "group": "Plugins",
        "pages": [
          "packages/engine-claude-cli",
          "packages/engine-codex",
          "packages/engine-grok-cli",
          "packages/engine-opencode-cli",
          "packages/engine-agent-sdk",
          "packages/engine-anthropic-api",
          "packages/memory-git",
          "packages/memory-simple"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/production-lines",
      "destination": "/workflows"
    },
    {
      "source": "/production-lines/offline-review",
      "destination": "/workflows/offline-review"
    },
    {
      "source": "/production-lines/safe-change",
      "destination": "/workflows/safe-change"
    },
    {
      "source": "/production-lines/feature-delivery",
      "destination": "/workflows/feature-delivery"
    },
    {
      "source": "/concepts/callback-gates",
      "destination": "/reviewing/callback-gates"
    },
    {
      "source": "/graphs/callback-gate",
      "destination": "/reviewing/callback-gates"
    },
    {
      "source": "/graphs/review-loop",
      "destination": "/reviewing/review-loop"
    },
    {
      "source": "/proof/acceptance",
      "destination": "/reviewing/proof-acceptance"
    },
    {
      "source": "/storage/events-and-artifacts",
      "destination": "/recording/events-and-artifacts"
    },
    {
      "source": "/runtime/node-attempts",
      "destination": "/recording/node-attempts"
    },
    {
      "source": "/runtime/runner",
      "destination": "/driving/runner"
    }
  ]
}
