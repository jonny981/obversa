#!/usr/bin/env bash
# Peer-agent coordination: append one entry to the durable channel, then
# optionally wake a peer surface. The wakeup never carries the message —
# a cue only says "check the channel", so a forged cue is harmless.
set -euo pipefail

usage() {
  cat <<'HELP'
Usage: obversa-peer-send [--from <agent>] [--wake surface:N] <message...>

The sender comes from --from, or from $OBVERSA_AGENT when --from is
absent. The channel file comes from $OBVERSA_CHANNEL. The default is
~/dev/personal/obversa-coordination/channel.md. The wake cue carries the
sender name and the current repository head as a liveness token.
HELP
}

AGENT="${OBVERSA_AGENT:-}"
WAKE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --from) AGENT="${2:?--from needs an agent name}"; shift 2 ;;
    --wake) WAKE="${2:?--wake needs a surface ref}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
done
[ -n "$AGENT" ] || { echo "obversa-peer-send: no sender. Pass --from <agent> or set OBVERSA_AGENT." >&2; usage >&2; exit 2; }
case "$AGENT" in
  *[!A-Za-z0-9._-]*) echo "obversa-peer-send: sender must use only letters, digits, '.', '_', '-': $AGENT" >&2; exit 2 ;;
esac
[ $# -gt 0 ] || { usage >&2; exit 2; }

CHANNEL="${OBVERSA_CHANNEL:-$HOME/dev/personal/obversa-coordination/channel.md}"
STAMP="$(date -u '+%Y-%m-%dT%H:%MZ')"
{ printf '\n## %s %s\n' "$STAMP" "$AGENT"; printf '%s\n' "$*"; } >> "$CHANNEL"

# A bare agent name in --wake is resolved to a live surface via obversa-whereis
# (so `--wake grok` works, not just `--wake surface:59`). A surface:N ref or a
# UUID is already a target and passes through unchanged. If a name cannot be
# resolved to a live session, the channel post still lands; only the wake cue is
# skipped, with a note — a missed nudge is harmless because the channel is durable.
if [ -n "$WAKE" ]; then
  case "$WAKE" in
    surface:*|[0-9A-Fa-f]*-[0-9A-Fa-f]*-[0-9A-Fa-f]*-[0-9A-Fa-f]*-[0-9A-Fa-f]*) ;;
    *)
      if RESOLVED="$("$(dirname "$0")/obversa-whereis" "$WAKE" 2>/dev/null)"; then
        WAKE="$RESOLVED"
      else
        echo "obversa-peer-send: no live '$WAKE' surface to wake; channel post landed, wake cue skipped." >&2
        WAKE=""
      fi
      ;;
  esac
fi

if [ -n "$WAKE" ] && command -v cmux >/dev/null 2>&1; then
  HEAD="$(git rev-parse --short HEAD 2>/dev/null || echo nohead)"
  cmux send --surface "$WAKE" "${AGENT}@${HEAD} wakeup: check channel" >/dev/null 2>&1 || exit 0
  cmux send-key --surface "$WAKE" enter >/dev/null 2>&1 || true
fi
