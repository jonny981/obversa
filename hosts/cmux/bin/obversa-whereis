#!/usr/bin/env bash
# Resolve a live teammate's cmux surface by agent name, so nobody has to grep
# `cmux sessions` by hand. Prints the surface UUID of the agent's most recently
# active live session whose working directory is within the scope (default
# "obversa"), or exits non-zero if the agent has no live session in scope.
#
# Part of the team-coordination kit (the agent-neutral wakeup/discovery half).
# `obversa-peer-send --wake <agent>` uses it to turn a name into a surface.
set -euo pipefail

usage() { echo "usage: obversa-whereis <agent> [scope-substr]" >&2; }

AGENT="${1:-}"
[ -n "$AGENT" ] || { usage; exit 2; }
case "$AGENT" in
  -h|--help) usage; exit 0 ;;
  *[!A-Za-z0-9._-]*) echo "obversa-whereis: agent name must be letters, digits, '.', '_', '-'" >&2; exit 2 ;;
esac
SCOPE="${2:-obversa}"

command -v cmux >/dev/null 2>&1 || { echo "obversa-whereis: cmux not found" >&2; exit 3; }

# Pick the surface of the newest live session for this agent within the scope.
# cmux prints `updated=<ISO8601>` and `surface=<uuid>`; ISO timestamps sort
# lexically, so newest-first is a reverse sort on the timestamp column.
surface="$(cmux sessions 2>/dev/null | awk -v a="$AGENT" -v s="$SCOPE" '
  $1 == a && index($0, "pid_exists=yes") && index($0, s) {
    surf = ""; upd = "";
    for (i = 1; i <= NF; i++) {
      if ($i ~ /^surface=/) { sub(/^surface=/, "", $i); surf = $i }
      if ($i ~ /^updated=/) { sub(/^updated=/, "", $i); upd = $i }
    }
    if (surf != "") print upd "\t" surf
  }' | sort -r | head -1 | cut -f2)"

[ -n "$surface" ] || { echo "obversa-whereis: no live '$AGENT' session in scope '$SCOPE'" >&2; exit 1; }
printf '%s\n' "$surface"
