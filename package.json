{
  "name": "obversa",
  "private": true,
  "description": "A TypeScript workspace for reliable agent production lines.",
  "license": "MIT",
  "author": "Jonny Neill <jonnyneill@hotmail.com>",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "executionEnv": {
      "nodeVersion": "22.22.0"
    }
  },
  "scripts": {
    "prepare": "node scripts/configure-git-hooks.mjs",
    "build": "pnpm --recursive --if-present run build",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "typecheck:ts6": "pnpm --recursive --if-present run typecheck:ts6",
    "docs:validate": "cd docs/public && mint validate",
    "example:offline": "pnpm --filter @obversa/lines exec tsx ../../examples/production-lines/offline-review.line.ts",
    "example:packages": "pnpm --filter @obversa/memory exec tsx ../../examples/packages/memory.ts && pnpm --filter @obversa/memory-simple exec tsx ../../examples/packages/memory-simple.ts && pnpm --filter @obversa/memory-git exec tsx ../../examples/packages/memory-git.ts",
    "check:agent-instructions": "node scripts/check-agent-instructions.mjs",
    "check:workstream-branch": "node scripts/check-workstream-branch.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:consumer": "node scripts/check-clean-consumer.mjs",
    "check:commit": "node scripts/check-commit-policy.mjs",
    "test:commit-policy": "node --test scripts/check-commit-policy.spec.mjs",
    "test:agent-workflow": "node --test scripts/agent-workflow.spec.mjs",
    "stage:claim": "node scripts/stage-merge.mjs claim",
    "stage:finish": "node scripts/stage-merge.mjs finish",
    "stage:release": "node scripts/stage-merge.mjs release",
    "verify:d1": "pnpm check:agent-instructions && pnpm check:boundaries && pnpm test:agent-workflow && pnpm test:commit-policy && pnpm typecheck && pnpm typecheck:ts6 && pnpm test && pnpm build && pnpm check:packages && pnpm docs:validate && pnpm example:packages && pnpm example:offline && pnpm check:consumer",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@types/node": "22.12.0",
    "@typescript/typescript6": "6.0.2",
    "mint": "4.2.820",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
