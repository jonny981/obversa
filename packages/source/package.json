{
  "name": "@obversa/source",
  "version": "0.1.0",
  "description": "Open a git diff for inline review.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./testing": {
      "types": "./dist/src/testing.d.mts",
      "default": "./src/testing.mjs"
    },
    "./bin": {
      "types": "./dist/bin/obversa-review.d.mts",
      "default": "./bin/obversa-review.mjs"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p assets/tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-publish-allowlist.mjs",
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "shiki": "4.4.3",
    "@obversa/surfacer": "workspace:*"
  },
  "bin": {
    "obversa-review": "./bin/obversa-review.mjs"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "bin",
    "assets",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "http://publish-guard.invalid/",
    "@obversa:registry": "http://publish-guard.invalid/"
  },
  "obversa": {
    "skills": [
      "review-diff"
    ]
  },
  "keywords": [
    "agent",
    "graph",
    "workflow",
    "runtime",
    "obversa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonny981/obversa.git"
  },
  "homepage": "https://docs.obversa.ai",
  "bugs": {
    "url": "https://github.com/jonny981/obversa/issues"
  }
}
