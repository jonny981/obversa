{
  "name": "@obversa/builtin-workflows",
  "version": "0.1.0",
  "description": "Ready-made team workflows for Obversa.",
  "keywords": [
    "agent",
    "graph",
    "workflow",
    "runtime",
    "obversa",
    "software-factory",
    "product-factory",
    "agent-pipeline",
    "agent-harness",
    "domain-specific-harness",
    "multi-agent",
    "durable-workflow"
  ],
  "author": "Jonny Neill <jonnyneill@hotmail.com>",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts6": "tsc6 --noEmit -p tsconfig.json",
    "prepack": "node ../../scripts/check-publish-allowlist.mjs --build-proof",
    "prepublishOnly": "node ../../scripts/check-publish-allowlist.mjs"
  },
  "dependencies": {
    "@obversa/api": "workspace:^",
    "@obversa/runtime": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonny981/obversa.git"
  },
  "homepage": "https://docs.obversa.ai",
  "bugs": {
    "url": "https://github.com/jonny981/obversa/issues"
  }
}
