{
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "allowJs": true,
    "checkJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "lib": [
      "es2024",
      "dom"
    ],
    "types": [
      "node"
    ],
    "strict": false,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/client.mjs"
  ]
}
