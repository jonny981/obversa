{
  "name": "@obversa/surfacer",
  "version": "0.1.0",
  "description": "One secure local surface session.",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "prepublishOnly": "node ../../scripts/check-publish-allowlist.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "http://publish-guard.invalid/",
    "@obversa:registry": "http://publish-guard.invalid/"
  },
  "keywords": [
    "agent",
    "graph",
    "workflow",
    "runtime",
    "obversa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonnyneill/obversa.git"
  },
  "homepage": "https://docs.obversa.ai",
  "bugs": {
    "url": "https://github.com/jonnyneill/obversa/issues"
  }
}
