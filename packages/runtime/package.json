{
  "name": "@obversa/runtime",
  "version": "0.1.0",
  "description": "Model how your team really works. Durable agent workflows, reviews that send work back, no database needed.",
  "license": "MIT",
  "author": "Jonny Neill <jonnyneill@hotmail.com>",
  "type": "module",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./workflow-support": {
      "types": "./dist/workflow-support.d.ts",
      "import": "./dist/workflow-support.js"
    },
    "./env/command": {
      "types": "./dist/env/command.d.ts",
      "import": "./dist/env/command.js"
    },
    "./storage/local": {
      "types": "./dist/storage/local.d.ts",
      "import": "./dist/storage/local.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/check-publish-allowlist.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@obversa/core": "workspace:*",
    "p-limit": "^7.3.0",
    "toposort": "^2.0.2"
  },
  "peerDependencies": {
    "@obversa/api": "workspace:*"
  },
  "devDependencies": {
    "@obversa/api": "workspace:*",
    "@types/node": "22.12.0",
    "@types/toposort": "^2.0.7",
    "execa": "^9.6.1"
  },
  "keywords": [
    "agent",
    "graph",
    "workflow",
    "runtime",
    "obversa",
    "software-factory",
    "product-factory",
    "agent-pipeline",
    "agent-harness",
    "domain-specific-harness",
    "multi-agent",
    "durable-workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonny981/obversa.git"
  },
  "homepage": "https://docs.obversa.ai",
  "bugs": {
    "url": "https://github.com/jonny981/obversa/issues"
  }
}
