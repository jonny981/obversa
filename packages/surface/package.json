{
  "name": "@obversa/surface",
  "version": "0.1.0",
  "description": "One secure local surface session.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./src/client.mjs"
    }
  },
  "scripts": {
    "test": "node --test --test-timeout=60000 test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "prepack": "node ../../scripts/check-publish-allowlist.mjs --build-proof",
    "prepublishOnly": "node ../../scripts/check-publish-allowlist.mjs",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build-browser.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent",
    "graph",
    "workflow",
    "runtime",
    "obversa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonny981/obversa.git"
  },
  "homepage": "https://docs.obversa.ai",
  "bugs": {
    "url": "https://github.com/jonny981/obversa/issues"
  }
}
