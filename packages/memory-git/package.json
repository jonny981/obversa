{
  "name": "@obversa/memory-git",
  "version": "0.1.0",
  "description": "Git-backed memory adapter for Obversa runtimes",
  "author": "Jonny Neill <jonnyneill@hotmail.com>",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts6": "tsc6 --noEmit -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@obversa/memory": "workspace:^",
    "execa": "^9.6.1"
  }
}
