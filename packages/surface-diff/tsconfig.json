{
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": [
      "es2024"
    ],
    "types": [
      "node"
    ],
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "bin/**/*",
    "src/**/*",
    "test/**/*"
  ],
  "exclude": [
    "assets"
  ]
}
