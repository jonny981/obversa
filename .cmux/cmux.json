{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // Obversa host glue (F0). See hosts/cmux/README.md.
  // Command Palette: type "Order Workspace". The first run asks for trust.
  "commands": [
    {
      "name": "Order Workspace",
      "keywords": ["obversa", "order", "editor", "workspace"],
      "command": "\"$(git rev-parse --show-toplevel)/hosts/cmux/bin/obversa-order-workspace\""
    }
  ]

